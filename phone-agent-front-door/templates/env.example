# Copy to .env, fill in your own values, then: chmod 600 .env
# Load with: set -a; . ./.env; set +a

# --- required -----------------------------------------------------------------
# The account that owns the number. Not a secret, but keep it out of screenshots.
PHONE_AGENT_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The auth token that SIGNS the webhooks. Never commit this.
# Prefer a command hook over the plain variable:
# PHONE_AGENT_TWILIO_AUTH_TOKEN_CMD='your-vault-cli read -name TWILIO_AUTH_TOKEN'
# ...or a 0600 file:
# PHONE_AGENT_TWILIO_AUTH_TOKEN_FILE=~/.config/phone-agent/auth_token
PHONE_AGENT_TWILIO_AUTH_TOKEN=

# Six or more digits. Guards the agent, not the menu.
# PHONE_AGENT_PIN_CMD='your-vault-cli read -name PHONE_PIN'
PHONE_AGENT_PIN=

# --- strongly advised ---------------------------------------------------------
# E.164, comma separated. An EMPTY allowlist makes the gateway refuse to start,
# so replace this with your own number. The shape is +<country><number>.
PHONE_AGENT_ALLOWLIST=

# Set to 1 only if you genuinely want an open menu. Prefer the allowlist.
# PHONE_AGENT_ALLOW_ANY=1

# The exact HTTPS base Twilio calls. Used when rebuilding the signed URL.
PHONE_AGENT_PUBLIC_URL=https://voice.example.com

# --- optional -----------------------------------------------------------------
PHONE_AGENT_DATA=~/.local/share/phone-agent
PHONE_AGENT_PORT=8097
PHONE_AGENT_HOST=127.0.0.1
PHONE_AGENT_PIN_TRIES=3
PHONE_AGENT_LOCKOUT_SECONDS=3600
PHONE_AGENT_VOICE=Polly.Amy-Neural
PHONE_AGENT_LANGUAGE=en-GB
