# Copy to .env and fill in your printer's values (never commit .env)
#
# PRINTER_HOST can be:
#   a) the printer's LAN IP (use when the dashboard runs on the same network
#      as the printer — e.g. your home machine): 192.168.40.126
#   b) a relay/tailnet host that forwards 8898/8899/8080 to the printer
#      (use when the dashboard runs elsewhere — e.g. a VPS): 100.x.x.x
#
# PRINTER_SERIAL / PRINTER_CHECK_CODE: from the printer's Device Info screen
# (or the printer state file on the machine that already drives the printer).
#
# NOTE: the printer must be in LAN-only mode (Settings -> WiFi -> Network Mode
# -> Local Network Only) for the local HTTP API (8898) to be served.

# --- João's home machine (direct LAN) ---
PRINTER_HOST=192.168.40.126
PRINTER_SERIAL=
PRINTER_CHECK_CODE=

# --- VPS / relay deployment (same printer, through the tailnet relay) ---
# PRINTER_HOST=100.x.x.x
# PRINTER_SERIAL=
# PRINTER_CHECK_CODE=

PORT=8890

# --- Comms bridge (optional — chat with your Hermes agent from the panel) ---
# DISCORD_BOT_TOKEN=      # Discord bot token that DMs the one-time unlock code
# DISCORD_USER_ID=        # Discord user id that receives the unlock code DM
# API_SERVER_URL=         # Hermes api_server base, e.g. http://172.28.0.1:8642/v1
# API_SERVER_KEY=         # bearer key for the Hermes api_server
# OTP_TTL=600             # unlock code lifetime (seconds)
# SESSION_TTL=86400       # chat session lifetime (seconds)
# OTP_MIN_INTERVAL=20     # min seconds between code requests
# OTP_MAX_ATTEMPTS=5      # max failed attempts before re-lock

# --- Replicator Preview (rotating STL GIF, optional) ---
# PREVIEW_MODELS_DIR=models   # dir tree scanned for STL models (compose mounts ./models)
# PREVIEW_CACHE_DIR=cache     # where generated GIFs are cached (compose mounts ./preview_cache)
# PREVIEW_SIZE=320            # GIF frame size px
# PREVIEW_FRAMES=24           # frames per rotation
# PREVIEW_FPS=12              # GIF speed
# PREVIEW_TILT=28             # camera elevation degrees
